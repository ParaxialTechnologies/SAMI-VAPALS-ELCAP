"RTN","SAMICSV",259,0)
ONEFORM(SITEID,SAMIFORM,SAMIDIR) ; process one form for a site
"RTN","SAMICSV",260,0)
 ;
"RTN","SAMICSV",261,0)
 n root s root=$$setroot^%wd("vapals-patients")
"RTN","SAMICSV",262,0)
 n groot s groot=$na(@root@("graph"))
"RTN","SAMICSV",263,0)
 n SAMII S SAMII=SITEID
"RTN","SAMICSV",264,0)
 n cnt s cnt=0
"RTN","SAMICSV",265,0)
 n forms s forms=0
"RTN","SAMICSV",266,0)
 ;
"RTN","SAMICSV",267,0)
 n SAMIOUT S SAMIOUT=$NA(^TMP("SAMICSV",$J))
"RTN","SAMICSV",268,0)
 k @SAMIOUT
"RTN","SAMICSV",269,0)
 ;
"RTN","SAMICSV",270,0)
 n DICT
"RTN","SAMICSV",271,0)
 d DDICT("DICT",SAMIFORM) ; get the data dictionary for this form
"RTN","SAMICSV",272,0)
 q:'$d(DICT)
"RTN","SAMICSV",273,0)
 ;
"RTN","SAMICSV",274,0)
 N SAMIN S SAMIN=1
"RTN","SAMICSV",275,0)
 N SAMIJJ s SAMIJJ=0
"RTN","SAMICSV",276,0)
 N OFFSET S OFFSET=1
"RTN","SAMICSV",277,0)
 d  ; start with last5 and name for all forms
"RTN","SAMICSV",278,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="last5"
"RTN","SAMICSV",279,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",280,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="saminame"
"RTN","SAMICSV",281,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",282,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="simrn"
"RTN","SAMICSV",283,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",284,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sipid"
"RTN","SAMICSV",285,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",286,0)
 ;
"RTN","SAMICSV",287,0)
 I SAMIFORM="siform" d  ;
"RTN","SAMICSV",288,0)
 . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",289,0)
 . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="saminame"
"RTN","SAMICSV",290,0)
 . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",291,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="ssn"
"RTN","SAMICSV",292,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",293,0)
 . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="last5"
"RTN","SAMICSV",294,0)
 . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",295,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sex"
"RTN","SAMICSV",296,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",297,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sbdob"
"RTN","SAMICSV",298,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",299,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="samiru"
"RTN","SAMICSV",300,0)
 f  s SAMIJJ=$o(DICT(SAMIJJ)) q:+SAMIJJ=0  d  ;
"RTN","SAMICSV",301,0)
 . s $p(@SAMIOUT@(SAMIN),"|",SAMIJJ+OFFSET)=DICT(SAMIJJ) ; csv header
"RTN","SAMICSV",302,0)
 s @SAMIOUT@(SAMIN)="siteid|samistudyid|form|"_@SAMIOUT@(SAMIN)
"RTN","SAMICSV",303,0)
 ;S @SAMIOUT@(SAMIN)=@SAMIOUT@(SAMIN)_$C(13,10) ; carriage return line feed
"RTN","SAMICSV",304,0)
 ; 
"RTN","SAMICSV",305,0)
 f  s SAMII=$o(@groot@(SAMII)) q:SAMII=""  q:$e(SAMII,1,3)'[SITEID  d  ;
"RTN","SAMICSV",306,0)
 . s cnt=cnt+1
"RTN","SAMICSV",307,0)
 . w !,SAMII
"RTN","SAMICSV",308,0)
 . N SAMIJ S SAMIJ=SAMIFORM
"RTN","SAMICSV",309,0)
 . n done s done=0
"RTN","SAMICSV",310,0)
 . f  s SAMIJ=$O(@groot@(SAMII,SAMIJ)) q:SAMIJ=""  q:done  d  ;
"RTN","SAMICSV",311,0)
 . . i $e(SAMIJ,1,$l(SAMIFORM))'=SAMIFORM s done=1 q  ;
"RTN","SAMICSV",312,0)
 . . s forms=forms+1
"RTN","SAMICSV",313,0)
 . . n jj s jj=0
"RTN","SAMICSV",314,0)
 . . s SAMIN=SAMIN+1
"RTN","SAMICSV",315,0)
 . . S OFFSET=1
"RTN","SAMICSV",316,0)
 . . n kk s kk=$o(@root@("sid",SAMII,""))
"RTN","SAMICSV",317,0)
 . . q:kk=""
"RTN","SAMICSV",318,0)
 . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",319,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"last5"))
"RTN","SAMICSV",320,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",321,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"saminame"))
"RTN","SAMICSV",322,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",323,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"simrn"))
"RTN","SAMICSV",324,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",325,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"sipid"))
"RTN","SAMICSV",326,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",327,0)
 . . ;
"RTN","SAMICSV",328,0)
 . . I SAMIFORM="siform" d  ;
"RTN","SAMICSV",329,0)
 . . . ;n kk s kk=$o(@root@("sid",SAMII,""))
"RTN","SAMICSV",330,0)
 . . . ;q:kk=""
"RTN","SAMICSV",331,0)
 . . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",332,0)
 . . . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"saminame"))
"RTN","SAMICSV",333,0)
 . . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",334,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"ssn"))
"RTN","SAMICSV",335,0)
 . . . S OFFSET=OFFSET+1
"RTN","SAMICSV",336,0)
 . . . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"last5"))
"RTN","SAMICSV",337,0)
 . . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",338,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"sex"))
"RTN","SAMICSV",339,0)
 . . . S OFFSET=OFFSET+1
"RTN","SAMICSV",340,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"sbdob"))
"RTN","SAMICSV",341,0)
 . . . S OFFSET=OFFSET+1
"RTN","SAMICSV",342,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"samiru"))
"RTN","SAMICSV",343,0)
 . . f  s jj=$o(DICT(jj)) q:+jj=0  d  ;
"RTN","SAMICSV",344,0)
 . . . ;s $P(@SAMIOUT@(SAMIN),"|",OFFSET+jj)=""""_$g(@groot@(SAMII,SAMIJ,DICT(jj)))_""""
"RTN","SAMICSV",345,0)
 . . . n val
"RTN","SAMICSV",346,0)
 . . . ;s val=$g(@groot@(SAMII,SAMIJ,DICT(jj)))_""""
"RTN","SAMICSV",347,0)
 . . . s val=$g(@groot@(SAMII,SAMIJ,DICT(jj)))
"RTN","SAMICSV",348,0)
 . . . i val'="" d  ;
"RTN","SAMICSV",349,0)
 . . . . s val=$tr(val,$char(11))
"RTN","SAMICSV",350,0)
 . . . . s val=$tr(val,$char(13))
"RTN","SAMICSV",351,0)
 . . . . d findReplaceAll^%ts(.val,"""","""""")
"RTN","SAMICSV",352,0)
 . . . . s val=""""_val_""""
"RTN","SAMICSV",353,0)
 . . . s $P(@SAMIOUT@(SAMIN),"|",OFFSET+jj)=val
"RTN","SAMICSV",354,0)
 . . S @SAMIOUT@(SAMIN)=SITEID_"|"_SAMII_"|"_SAMIJ_"|"_@SAMIOUT@(SAMIN)
"RTN","SAMICSV",355,0)
 . . ;s @SAMIOUT@(SAMIN)=@SAMIOUT@(SAMIN)_$C(13,10)
"RTN","SAMICSV",356,0)
 . ;b
"RTN","SAMICSV",357,0)
 ;ZWR @SAMIOUT@(*)
"RTN","SAMICSV",358,0)
 w !,cnt_" patients, "_forms_" forms"
"RTN","SAMICSV",359,0)
 n filename s filename=$$FNAME(SITEID,SAMIFORM)
"RTN","SAMICSV",360,0)
 d GTF^%ZISH($na(@SAMIOUT@(1)),3,SAMIDIR,filename)
"RTN","SAMICSV",361,0)
 w !,"file "_filename_" written to directory "_SAMIDIR
"RTN","SAMICSV",362,0)
 ;
"RTN","SAMICSV",363,0)
 k @SAMIOUT
"RTN","SAMICSV",364,0)
 ;
"RTN","SAMICSV",365,0)
 quit  ; end of ONEFORM
