 . . . . d findReplaceAll^%ts(.val,"""","""""")
"RTN","SAMICSV",345,0)
 . . . . s val=""""_val_""""
"RTN","SAMICSV",346,0)
 . . . s $P(@SAMIOUT@(SAMIN),"|",OFFSET+jj)=val
