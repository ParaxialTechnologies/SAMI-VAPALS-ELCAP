ADDITEMS(ARY,SID) ; add Image items to Items array
"RTN","SAMIDCM2",125,0)
 ;
"RTN","SAMIDCM2",126,0)
 new root set root=$$setroot^%wd("dcm-intake")
"RTN","SAMIDCM2",127,0)
 new proot set proot=$$setroot^%wd("vapals-patients")
"RTN","SAMIDCM2",128,0)
 new pien,simrn
"RTN","SAMIDCM2",129,0)
 set pien=$o(@proot@("sid",SID,""))
"RTN","SAMIDCM2",130,0)
 set simrn=$g(@proot@(pien,"simrn"))
"RTN","SAMIDCM2",131,0)
 q:simrn=""
"RTN","SAMIDCM2",132,0)
 ;
"RTN","SAMIDCM2",133,0)
 ;q:'$d(@root@("studyid",SID)) ; nothing to add
"RTN","SAMIDCM2",134,0)
 ;
"RTN","SAMIDCM2",135,0)
 n images s images=""
"RTN","SAMIDCM2",136,0)
 n ien s ien=""
"RTN","SAMIDCM2",137,0)
 ;f  s ien=$o(@root@("studyid",SID,ien)) q:ien=""  d  ;
"RTN","SAMIDCM2",138,0)
 f  s ien=$o(@root@("emrn","e"_simrn,ien)) q:ien=""  d  ;
"RTN","SAMIDCM2",139,0)
 . n studydt s studydt=$g(@root@(ien,"json","StudyDate"))
"RTN","SAMIDCM2",140,0)
 . q:studydt=""
"RTN","SAMIDCM2",141,0)
 . ;
"RTN","SAMIDCM2",142,0)
 . n siuid s siuid=$g(@root@(ien,"json","StudyInstanceUID"))
"RTN","SAMIDCM2",143,0)
 . q:siuid=""
"RTN","SAMIDCM2",144,0)
 . ;
"RTN","SAMIDCM2",145,0)
 . ; add each image item only once to Items array
"RTN","SAMIDCM2",146,0)
 . q:$d(images(siuid))
"RTN","SAMIDCM2",147,0)
 . s images(siuid)=""
"RTN","SAMIDCM2",148,0)
 . ;
"RTN","SAMIDCM2",149,0)
 . n key s key="image-"_$e(studydt,1,4)_"-"_$e(studydt,5,6)_"-"_$e(studydt,7,8)
"RTN","SAMIDCM2",150,0)
 . n fmdt s fmdt=$$KEY2FM^SAMICASE(key)
"RTN","SAMIDCM2",151,0)
 . s @ARY@("sort",fmdt,"image",key,"Image")=siuid
"RTN","SAMIDCM2",152,0)
 . q
"RTN","SAMIDCM2",153,0)
 ;
"RTN","SAMIDCM2",154,0)
 quit  ; end of ADDITEMS
