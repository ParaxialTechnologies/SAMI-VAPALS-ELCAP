"RTN","SAMIDCM1",242,0)
 ;patient_study_details 
"RTN","SAMIDCM1",243,0)
 ;--Frame of Reference UID 1.3.6.1.4.1.14519.5.2.1.6279.6001.178796764874541005921876698858
"RTN","SAMIDCM1",244,0)
