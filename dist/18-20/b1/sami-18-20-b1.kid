"RTN","SAMIDCM1",247,0)
 ;--Patient's Birth Date 
"RTN","SAMIDCM1",248,0)
 ;--\s 
"RTN","SAMIDCM1",249,0)
 ;--Patient's Name 
"RTN","SAMIDCM1",250,0)
 ;--\s 
"RTN","SAMIDCM1",251,0)
 ;--Patient's Sex F
"RTN","SAMIDCM1",252,0)
 ;--SOP Class UID 1.2.840.10008.5.1.4.1.1.88.34
"RTN","SAMIDCM1",253,0)
 ;--Series Description AIRC Research Structured Report
"RTN","SAMIDCM1",254,0)
 ;--Slice Thickness 1
"RTN","SAMIDCM1",255,0)
 ;--\n 1.0
"RTN","SAMIDCM1",256,0)
 ;--Study Date 20000101
"RTN","SAMIDCM1",257,0)
 ;--\s 
"RTN","SAMIDCM1",258,0)
 ;--Tracking Identifier L2
"RTN","SAMIDCM1",259,0)
 ;--Tracking Unique Identifier
"RTN","SAMIDCM1",260,0)
 ;
"RTN","SAMIDCM1",261,0)
 d  ; Extract Identifying information
"RTN","SAMIDCM1",262,0)
 . n vars
"RTN","SAMIDCM1",263,0)
 . n name s name=$g(@gp@("Patient's Name"))
"RTN","SAMIDCM1",264,0)
 . i name="" s name=$g(@gp@("PatientName"))
"RTN","SAMIDCM1",265,0)
 . i name="" s vars("name")=name
"RTN","SAMIDCM1",266,0)
 . e  s vars("name")=$$NORMALIZ(name)
"RTN","SAMIDCM1",267,0)
 . n dob s dob=$g(@gp@("Patient's Birth Date"))
"RTN","SAMIDCM1",268,0)
 . i dob="" s dob=20000302
"RTN","SAMIDCM1",269,0)
 . s vars("dob")=dob
"RTN","SAMIDCM1",270,0)
 . n gender s gender=$g(@gp@("Patient's Sex"))
"RTN","SAMIDCM1",271,0)
 . i gender="" s gender="M"
"RTN","SAMIDCM1",272,0)
 . s vars("gender")=gender
"RTN","SAMIDCM1",273,0)
 . ;n patid s patid=$g(@gp@("Patient ID"))
"RTN","SAMIDCM1",274,0)
 . ;i patid="" s patid=$g(@gp@("PatientID"))
"RTN","SAMIDCM1",275,0)
 . ;s vars("patid")=patid
"RTN","SAMIDCM1",276,0)
 . ;
"RTN","SAMIDCM1",277,0)
 . ; Although the json uses the label Patient ID or PatientID, 
"RTN","SAMIDCM1",278,0)
 . ;  the entry is interpreted as the Medical Record Number or mrn
"RTN","SAMIDCM1",279,0)
 . ;  and is stored in the variable simrn 
"RTN","SAMIDCM1",280,0)
 . ;  and is indexed in the index emrn, prefixed by an "e" to
"RTN","SAMIDCM1",281,0)
 . ;   insure that it is treated as a string in the index
"RTN","SAMIDCM1",282,0)
 . ;  it is displayed in the header of every form and can be
"RTN","SAMIDCM1",283,0)
 . ;  viewed and modified on the intake form
"RTN","SAMIDCM1",284,0)
 . ;
"RTN","SAMIDCM1",285,0)
 . ; Also on the intake form, another unique identifier can be
"RTN","SAMIDCM1",286,0)
 . ;  added for the patient, called on the form the Studyid
"RTN","SAMIDCM1",287,0)
 . ;  it is stored in the variable sipid
"RTN","SAMIDCM1",288,0)
 . ;  It is not known until it is entered manually on the intake form
"RTN","SAMIDCM1",289,0)
 . ;
"RTN","SAMIDCM1",290,0)
 . ; See more documentation in SAMIUID.m
"RTN","SAMIDCM1",291,0)
 . ;
"RTN","SAMIDCM1",292,0)
 . n simrn s simrn=$g(@gp@("Patient ID"))
"RTN","SAMIDCM1",293,0)
 . i simrn="" s simrn=$g(@gp@("PatientID"))
"RTN","SAMIDCM1",294,0)
 . s vars("simrn")=simrn
"RTN","SAMIDCM1",295,0)
 . n studyDate s studyDate=$g(@gp@("Study Date"))
"RTN","SAMIDCM1",296,0)
 . i studyDate'="" s vars("studyDate")=studyDate
"RTN","SAMIDCM1",297,0)
 . n trackID s trackID=$g(@gp@("Tracking Identifier"))
"RTN","SAMIDCM1",298,0)
 . s vars("trackingIdentifier")=trackID
"RTN","SAMIDCM1",299,0)
 . s vars("site")=site
"RTN","SAMIDCM1",300,0)
 . s vars("ssn")=999999999
"RTN","SAMIDCM1",301,0)
 . s vars("sistatus")="active"
"RTN","SAMIDCM1",302,0)
 . ;
"RTN","SAMIDCM1",303,0)
 . i '$$MATCH^SAMIDCM1(.vars) d CREATE^SAMIZPH1(.vars)
"RTN","SAMIDCM1",304,0)
 . m @root@(ien)=vars
"RTN","SAMIDCM1",305,0)
 . s name=$g(vars("name"))
"RTN","SAMIDCM1",306,0)
 . i name'="" s @root@("name",name,ien)=""
"RTN","SAMIDCM1",307,0)
 . n studyid s studyid=$g(vars("studyid"))
"RTN","SAMIDCM1",308,0)
 . i studyid'="" s @root@("studyid",studyid,ien)=""
"RTN","SAMIDCM1",309,0)
 . n dfn s dfn=$g(vars("dfn"))
"RTN","SAMIDCM1",310,0)
 . i dfn'="" s @root@("dfn",dfn,ien)=""
"RTN","SAMIDCM1",311,0)
 . i simrn'="" s @root@("emrn","e"_simrn,ien)=""
"RTN","SAMIDCM1",312,0)
 . q
"RTN","SAMIDCM1",313,0)
 ;
"RTN","SAMIDCM1",314,0)
 ;
"RTN","SAMIDCM1",315,0)
 set return("status")="ok"
"RTN","SAMIDCM1",316,0)
 set return("siteid")=site
"RTN","SAMIDCM1",317,0)
 set return("ien")=ien
"RTN","SAMIDCM1",318,0)
 ;
"RTN","SAMIDCM1",319,0)
 if $get(ARGS("returngraph"))=1 do  ;
"RTN","SAMIDCM1",320,0)
 . merge return("graph")=@root@(ien)
"RTN","SAMIDCM1",321,0)
 . q
"RTN","SAMIDCM1",322,0)
