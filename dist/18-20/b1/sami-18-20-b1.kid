SAYFORM() ; prompts for the form
"RTN","SAMICSV",192,0)
 ;
"RTN","SAMICSV",193,0)
 ;@stanza 2 define set of codes
"RTN","SAMICSV",194,0)
 ;
"RTN","SAMICSV",195,0)
 N ZF
"RTN","SAMICSV",196,0)
 S ZF(1)="siform"
"RTN","SAMICSV",197,0)
 S ZF(2)="sbform"
"RTN","SAMICSV",198,0)
 S ZF(3)="ceform"
"RTN","SAMICSV",199,0)
 S ZF(4)="fuform"
"RTN","SAMICSV",200,0)
 S ZF(5)="bxform"
"RTN","SAMICSV",201,0)
 S ZF(6)="itform"
"RTN","SAMICSV",202,0)
 S ZF(7)="ptform"
"RTN","SAMICSV",203,0)
 N DIR S DIR(0)="SO^"
"RTN","SAMICSV",204,0)
 N ZI
"RTN","SAMICSV",205,0)
 F ZI=1:1:7 S DIR(0)=DIR(0)_ZI_":"_ZF(ZI)_";"
"RTN","SAMICSV",206,0)
 ;
"RTN","SAMICSV",207,0)
 ;
"RTN","SAMICSV",208,0)
 ;@stanza 3 set up prompt
"RTN","SAMICSV",209,0)
 ;
