EN ; entry point to generate csv files from forms for a site
"RTN","SAMICSV",139,0)
 ;
"RTN","SAMICSV",140,0)
 ;@stanza 2 select site
"RTN","SAMICSV",141,0)
 ;
"RTN","SAMICSV",142,0)
 ; first pick a site
"RTN","SAMICSV",143,0)
 N X,Y,DIC,SITEIEN,SITEID
"RTN","SAMICSV",144,0)
 S DIC=311.12
"RTN","SAMICSV",145,0)
 S DIC(0)="AEMQ"
"RTN","SAMICSV",146,0)
 D ^DIC
"RTN","SAMICSV",147,0)
 I Y<1 Q  ; EXIT
"RTN","SAMICSV",148,0)
 S SITENUM=$P(Y,"^",2)
"RTN","SAMICSV",149,0)
 ;
"RTN","SAMICSV",150,0)
 S SITEID=$$SITEID^SAMISITE(SITENUM)
"RTN","SAMICSV",151,0)
 Q:SITEID=""
"RTN","SAMICSV",152,0)
 ;
"RTN","SAMICSV",153,0)
 ;
"RTN","SAMICSV",154,0)
 ;@stanza 3 select form
"RTN","SAMICSV",155,0)
 ;
"RTN","SAMICSV",156,0)
 N SAMIFORM S SAMIFORM=$$SAYFORM()
"RTN","SAMICSV",157,0)
 Q:SAMIFORM=-1
"RTN","SAMICSV",158,0)
 ;
"RTN","SAMICSV",159,0)
 ;
"RTN","SAMICSV",160,0)
 ;@stanza 4 select directory
"RTN","SAMICSV",161,0)
 ;
"RTN","SAMICSV",162,0)
 ; prompt for the directory
"RTN","SAMICSV",163,0)
 N SAMIDIR
"RTN","SAMICSV",164,0)
 D GETDIR^SAMIFDM(.SAMIDIR)
"RTN","SAMICSV",165,0)
 Q:SAMIDIR=""
"RTN","SAMICSV",166,0)
 ;
"RTN","SAMICSV",167,0)
 d ONEFORM(SITEID,SAMIFORM,SAMIDIR) ; process one form for a site
"RTN","SAMICSV",168,0)
 ;
"RTN","SAMICSV",169,0)
 ;
"RTN","SAMICSV",170,0)
 ;@stanza 5 termination
"RTN","SAMICSV",171,0)
 ;
"RTN","SAMICSV",172,0)
 quit  ; end of EN
