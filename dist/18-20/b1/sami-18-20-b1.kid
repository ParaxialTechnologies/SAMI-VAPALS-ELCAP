 s root=$$setroot^%wd("dcm-intake")
"RTN","SAMIDCM1",334,0)
 s ien=""
"RTN","SAMIDCM1",335,0)
 f  s ien=$o(@root@(ien)) q:ien=""  d  ;
"RTN","SAMIDCM1",336,0)
 . n gp s gp=$na(@root@(ien,"json","patient_study_details"))
"RTN","SAMIDCM1",337,0)
 . i '$d(@gp) d  ;
