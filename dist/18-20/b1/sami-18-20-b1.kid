IDXDCM(dien,ARY) ; index a dcm entry after patient record creation
"RTN","SAMIDCM1",710,0)
 ;
"RTN","SAMIDCM1",711,0)
 n droot s droot=$$setroot^%wd("dcm-intake")
"RTN","SAMIDCM1",712,0)
 i $d(ARY) m @droot@(dien)=ARY
"RTN","SAMIDCM1",713,0)
 d  ;
"RTN","SAMIDCM1",714,0)
 . n x
"RTN","SAMIDCM1",715,0)
 . s x=$g(@droot@(dien,"dfn"))
"RTN","SAMIDCM1",716,0)
 . if x'="" s @droot@("dfn",x,dien)=""
"RTN","SAMIDCM1",717,0)
 . s x=$g(@droot@(dien,"saminame"))
"RTN","SAMIDCM1",718,0)
 . i x="" s x=$g(@droot@(dien,"name"))
"RTN","SAMIDCM1",719,0)
 . i x'="" s @droot@("name",x,dien)=""
"RTN","SAMIDCM1",720,0)
 . s x=$g(@droot@(dien,"studyid"))
"RTN","SAMIDCM1",721,0)
 . i x="" s x=$g(@droot@(dien,"sid"))
"RTN","SAMIDCM1",722,0)
 . i x'="" s @droot@("sid",x,dien)=""
"RTN","SAMIDCM1",723,0)
 . q
"RTN","SAMIDCM1",724,0)
 ;
"RTN","SAMIDCM1",725,0)
 quit  ; end of IDXDCM
