WSDCMIN(ARGS,BODY,RESULT,ien) ; receive from addpatient
"RTN","SAMIDCM1",179,0)
 ;
"RTN","SAMIDCM1",180,0)
 s U="^"
"RTN","SAMIDCM1",181,0)
 ;S DUZ=1
"RTN","SAMIDCM1",182,0)
 ;S DUZ("AG")="V"
"RTN","SAMIDCM1",183,0)
 ;S DUZ(2)=500
"RTN","SAMIDCM1",184,0)
 ;N USER S USER=$$DUZ^SYNDHP69
"RTN","SAMIDCM1",185,0)
 ;
"RTN","SAMIDCM1",186,0)
 new json,root,gr,id,return
"RTN","SAMIDCM1",187,0)
 set root=$$setroot^%wd("dcm-intake")
"RTN","SAMIDCM1",188,0)
 if $get(ien)="" do
"RTN","SAMIDCM1",189,0)
 . set ien=$order(@root@(" "),-1)+1
"RTN","SAMIDCM1",190,0)
 . set gr=$name(@root@(ien,"json"))
"RTN","SAMIDCM1",191,0)
 . do decode^%webjson("BODY",gr)
"RTN","SAMIDCM1",192,0)
 . kill BODY ;
"RTN","SAMIDCM1",193,0)
 . q
"RTN","SAMIDCM1",194,0)
 ;
"RTN","SAMIDCM1",195,0)
 ;do indexFhir(ien)
"RTN","SAMIDCM1",196,0)
 ;
"RTN","SAMIDCM1",197,0)
 set site=$get(ARGS("siteid"))
"RTN","SAMIDCM1",198,0)
 if site="" set site="XXX" ; default to test site
"RTN","SAMIDCM1",199,0)
 if site'="" set @root@("SITE",site,ien)="" ;
"RTN","SAMIDCM1",200,0)
 ;
"RTN","SAMIDCM1",201,0)
 ;
"RTN","SAMIDCM1",202,0)
 n gp s gp=$na(@root@(ien,"json","patient_study_details"))
"RTN","SAMIDCM1",203,0)
 i '$d(@gp) d  ;
"RTN","SAMIDCM1",204,0)
 . s gp=$na(@root@(ien,"patient_details"))
"RTN","SAMIDCM1",205,0)
 . q:$d(@gp)
"RTN","SAMIDCM1",206,0)
 . s gp=$na(@root@(ien,"json"))
"RTN","SAMIDCM1",207,0)
 . q:$d(@gp@("PatientName"))
"RTN","SAMIDCM1",208,0)
 . s return("error")="Missing patient study details"
"RTN","SAMIDCM1",209,0)
 . q
"RTN","SAMIDCM1",210,0)
 ;
"RTN","SAMIDCM1",211,0)
 n simrn s simrn=$g(@gp@("Patient ID"))
"RTN","SAMIDCM1",212,0)
 i simrn="" s simrn=$g(@gp@("PatientID"))
"RTN","SAMIDCM1",213,0)
 ; enter the mrn into the mrn index
"RTN","SAMIDCM1",214,0)
 i simrn'="" s @root@("emrn","e"_simrn,ien)=""
"RTN","SAMIDCM1",215,0)
 ; that's all we're going to do on receiving a json message
"RTN","SAMIDCM1",216,0)
 ;  announcing the availablity of an image. The "matching"
"RTN","SAMIDCM1",217,0)
 ;  will be done when the Case Review page is generated for the patient
"RTN","SAMIDCM1",218,0)
 ; The Unmatched image report will do a comparison and list those
"RTN","SAMIDCM1",219,0)
 ;  images which do not have a mrn which matches
"RTN","SAMIDCM1",220,0)
 ; 
"RTN","SAMIDCM1",221,0)
 ;
"RTN","SAMIDCM1",222,0)
 set return("status")="ok"
"RTN","SAMIDCM1",223,0)
 set return("siteid")=site
"RTN","SAMIDCM1",224,0)
 set return("ien")=ien
"RTN","SAMIDCM1",225,0)
 ;
"RTN","SAMIDCM1",226,0)
 if $get(ARGS("returngraph"))=1 do  ;
"RTN","SAMIDCM1",227,0)
 . merge return("graph")=@root@(ien)
"RTN","SAMIDCM1",228,0)
 . q
"RTN","SAMIDCM1",229,0)
 ;
"RTN","SAMIDCM1",230,0)
 n jary
"RTN","SAMIDCM1",231,0)
 m jary("result")=return
"RTN","SAMIDCM1",232,0)
 d encode^%webjson("jary","RESULT")
"RTN","SAMIDCM1",233,0)
 s HTTPRSP("mime")="application/json"
"RTN","SAMIDCM1",234,0)
 ;
"RTN","SAMIDCM1",235,0)
 quit  ; end of ws WSDCMIN^SAMIDCM1
