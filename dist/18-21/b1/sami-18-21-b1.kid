"RTN","SAMIDCM1",547,0)
 . n nxtdfn s nxtdfn=$$nxtdfn^SAMIDCM1()
"RTN","SAMIDCM1",548,0)
 . s vars("saminame")="DOE"_nxtdfn_",JOHN"
"RTN","SAMIDCM1",549,0)
 . s vars("name")=vars("saminame")
"RTN","SAMIDCM1",550,0)
 . s vars("site")="XXX"
"RTN","SAMIDCM1",551,0)
 . s vars("ssn")=999999999
"RTN","SAMIDCM1",552,0)
 . s vars("sistatus")="active"
"RTN","SAMIDCM1",553,0)
 . d CREATE^SAMIZPH1(.vars)
"RTN","SAMIDCM1",554,0)
 . x "ZWR vars"
"RTN","SAMIDCM1",555,0)
 . q
"RTN","SAMIDCM1",556,0)
