"RTN","SAMIDCM1",585,0)
MATCH(vars) ; extrinsic which tries to match the message with an
"RTN","SAMIDCM1",586,0)
 ; existing record
"RTN","SAMIDCM1",587,0)
 ;
"RTN","SAMIDCM1",588,0)
 n lroot,proot,droot
"RTN","SAMIDCM1",589,0)
 s lroot=$$setroot^%wd("patient-lookup")
"RTN","SAMIDCM1",590,0)
 s proot=$$setroot^%wd("vapals-patients")
"RTN","SAMIDCM1",591,0)
 s droot=$$setroot^%wd("dcm-intake")
"RTN","SAMIDCM1",592,0)
 n found s found=0
"RTN","SAMIDCM1",593,0)
 n name s name=$$NORMALIZ($g(vars("name")))
"RTN","SAMIDCM1",594,0)
 n simrn s simrn=$g(vars("simrn"))
"RTN","SAMIDCM1",595,0)
 n dien,lien,pien
"RTN","SAMIDCM1",596,0)
 ;
"RTN","SAMIDCM1",597,0)
 ; first look at the dcm-intake for name matches
"RTN","SAMIDCM1",598,0)
 s dien=$o(@droot@("emrn","e"_simrn,""))
"RTN","SAMIDCM1",599,0)
 i dien="" s dien=$o(@droot@("name",name,""))
"RTN","SAMIDCM1",600,0)
 i dien'="" d  ; the name or mrn has been found locally
"RTN","SAMIDCM1",601,0)
 . s found=1
"RTN","SAMIDCM1",602,0)
 . n dfn,studyid
"RTN","SAMIDCM1",603,0)
 . s dfn=$g(@droot@(dien,"dfn"))
"RTN","SAMIDCM1",604,0)
 . i dfn'="" s vars("dfn")=dfn
"RTN","SAMIDCM1",605,0)
 . i dfn="" s found=0 q  ;
"RTN","SAMIDCM1",606,0)
 . s studyid=$g(@droot@(dien,"studyid"))
"RTN","SAMIDCM1",607,0)
 . i studyid="" s found=0 q  ;
"RTN","SAMIDCM1",608,0)
 . i studyid'="" s vars("studyid")=studyid
"RTN","SAMIDCM1",609,0)
 . q
"RTN","SAMIDCM1",610,0)
 ;
"RTN","SAMIDCM1",611,0)
 if found=1 q found
"RTN","SAMIDCM1",612,0)
 ;
"RTN","SAMIDCM1",613,0)
 i dien="" d  ; not here, check patient-lookup
"RTN","SAMIDCM1",614,0)
 . n simrn s simrn=$g(vars("simrn"))
"RTN","SAMIDCM1",615,0)
 . s lien=$o(@lroot@("emrn","e"_simrn,""))
"RTN","SAMIDCM1",616,0)
 . i lien="" s lien=$o(@lroot@("name",name,""))
"RTN","SAMIDCM1",617,0)
 . i lien="" s found=0 q  ;
"RTN","SAMIDCM1",618,0)
 . i lien'="" s found=1
"RTN","SAMIDCM1",619,0)
 . n dfn,studyid
"RTN","SAMIDCM1",620,0)
 . s dfn=$g(@lroot@(lien,"dfn"))
"RTN","SAMIDCM1",621,0)
 . s vars("dfn")=dfn
"RTN","SAMIDCM1",622,0)
 . i dfn="" s found=0 q  ;
"RTN","SAMIDCM1",623,0)
 . s pien=$o(@proot@("dfn",dfn,""))
"RTN","SAMIDCM1",624,0)
 . i pien="" d ENROLL^SAMIZPH1(.vars)
"RTN","SAMIDCM1",625,0)
 . s pien=$o(@proot@("dfn",dfn,""))
"RTN","SAMIDCM1",626,0)
 . i pien="" s found=0 q  ;
"RTN","SAMIDCM1",627,0)
 . s studyid=$g(@proot@(pien,"studyid"))
"RTN","SAMIDCM1",628,0)
 . s vars("studyid")=studyid
"RTN","SAMIDCM1",629,0)
 . i studyid="" s found=0 q  ;
"RTN","SAMIDCM1",630,0)
 . q
"RTN","SAMIDCM1",631,0)
 ;
"RTN","SAMIDCM1",632,0)
 quit found ; end of $$MATCH^SAMIDCM1
