"RTN","SAMIDCM1",305,0)
 . s vars("trackingIdentifier")=trackID
"RTN","SAMIDCM1",306,0)
 . s vars("site")=site
"RTN","SAMIDCM1",307,0)
 . s vars("ssn")=999999999
"RTN","SAMIDCM1",308,0)
 . s vars("sistatus")="active"
"RTN","SAMIDCM1",309,0)
