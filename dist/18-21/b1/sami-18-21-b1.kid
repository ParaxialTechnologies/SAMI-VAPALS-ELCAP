"RTN","SAMICSV2",596,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"siteid")
"RTN","SAMICSV2",597,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"samistudyid")
"RTN","SAMICSV2",598,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"form")
"RTN","SAMICSV2",599,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"last5")
"RTN","SAMICSV2",600,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"saminame")
"RTN","SAMICSV2",601,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"simrn")
"RTN","SAMICSV2",602,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"sipid")
"RTN","SAMICSV2",603,0)
 ;
"RTN","SAMICSV2",604,0)
 I form="siform" d  ;
"RTN","SAMICSV2",605,0)
 . s x=$$VARNUM(CSVHDR,CSVDICT,"ssn")
"RTN","SAMICSV2",606,0)
 . s x=$$VARNUM(CSVHDR,CSVDICT,"sex")
"RTN","SAMICSV2",607,0)
 . s x=$$VARNUM(CSVHDR,CSVDICT,"sddob")
"RTN","SAMICSV2",608,0)
 . s x=$$VARNUM(CSVHDR,CSVDICT,"samiru")
"RTN","SAMICSV2",609,0)
 ;
"RTN","SAMICSV2",610,0)
 n i
"RTN","SAMICSV2",611,0)
 s i=0
"RTN","SAMICSV2",612,0)
 f  s i=$o(DICT(i)) q:+i=0  d  ;
"RTN","SAMICSV2",613,0)
 . s x=$$VARNUM(CSVHDR,CSVDICT,$g(DICT(i)))
"RTN","SAMICSV2",614,0)
 ;
"RTN","SAMICSV2",615,0)
 s x=$$VARNUM(CSVHDR,CSVDICT,"separator")
"RTN","SAMICSV2",616,0)
 q
"RTN","SAMICSV2",617,0)
 ;
"RTN","SAMICSV2",618,0)
BYNAME(RTN,ZNAME) ; extrinsic look up in triple store by name
"RTN","SAMICSV2",619,0)
 ; 1 if any found
"RTN","SAMICSV2",620,0)
 ; RTN returns multiple matches ... partials are allowed
"RTN","SAMICSV2",621,0)
 ;
"RTN","SAMICSV2",622,0)
 q
"RTN","SAMICSV2",623,0)
 ;
"RTN","SAMICSV2",624,0)
 ; lets step through retrieving the case review page and then
"RTN","SAMICSV2",625,0)
 ; the forms for a patient from the triple store
"RTN","SAMICSV2",626,0)
 ;
"RTN","SAMICSV2",627,0)
 ;  the root of the tree is the mrn. it is only found on the siform
"RTN","SAMICSV2",628,0)
 ;  so, we will start with the mrn
"RTN","SAMICSV2",629,0)
 ;
"RTN","SAMICSV2",630,0)
SPOMRN(TRTN,MRN,format) ; 
"RTN","SAMICSV2",631,0)
 ;
"RTN","SAMICSV2",632,0)
 N TMRN
"RTN","SAMICSV2",633,0)
 s:format="" format="json"
"RTN","SAMICSV2",634,0)
 S TMRN="?SI simrn "_MRN_" ."
"RTN","SAMICSV2",635,0)
 ;S TMRN="?SI simrn ?MRN ."
"RTN","SAMICSV2",636,0)
 ;D rpctrip^C0XGET2(.TRTN,TMRN,format)
"RTN","SAMICSV2",637,0)
 ZWR TRTN
"RTN","SAMICSV2",638,0)
 Q
"RTN","SAMICSV2",639,0)
 ;
"RTN","SAMICSV2",640,0)
EOR ; end of routine SAMICSV2
"RTN","SAMICUL")
