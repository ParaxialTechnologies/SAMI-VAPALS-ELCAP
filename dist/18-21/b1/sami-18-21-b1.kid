"RTN","SAMIDCM1",317,0)
 . i dfn'="" s @root@("dfn",dfn,ien)=""
"RTN","SAMIDCM1",318,0)
 . i simrn'="" s @root@("emrn","e"_simrn,ien)=""
"RTN","SAMIDCM1",319,0)
 . q
"RTN","SAMIDCM1",320,0)
