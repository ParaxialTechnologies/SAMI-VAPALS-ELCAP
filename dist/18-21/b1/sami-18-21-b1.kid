"RTN","SAMICSV2",150,0)
 S DIC=311.12
"RTN","SAMICSV2",151,0)
 S DIC(0)="AEMQ"
"RTN","SAMICSV2",152,0)
 D ^DIC
"RTN","SAMICSV2",153,0)
 I Y<1 Q  ; EXIT
"RTN","SAMICSV2",154,0)
 S SITENUM=$P(Y,"^",2)
"RTN","SAMICSV2",155,0)
 ;
"RTN","SAMICSV2",156,0)
