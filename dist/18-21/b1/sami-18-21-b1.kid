"RTN","SAMIDCM1",274,0)
 . n dob s dob=$g(@gp@("Patient's Birth Date"))
"RTN","SAMIDCM1",275,0)
 . i dob="" s dob=20000302
"RTN","SAMIDCM1",276,0)
 . s vars("dob")=dob
"RTN","SAMIDCM1",277,0)
 . n gender s gender=$g(@gp@("Patient's Sex"))
"RTN","SAMIDCM1",278,0)
