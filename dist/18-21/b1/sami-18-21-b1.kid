NORMALIZ(name) ; extrinsic which tries to normalize the name
"RTN","SAMIDCM1",654,0)
 ;
"RTN","SAMIDCM1",655,0)
 n znam s znam=name
"RTN","SAMIDCM1",656,0)
 i name["^" d  q znam  ;; if name has Dicom separator
"RTN","SAMIDCM1",657,0)
 . s znam=$tr(znam,"^",",")
"RTN","SAMIDCM1",658,0)
 . q
"RTN","SAMIDCM1",659,0)
 ;
"RTN","SAMIDCM1",660,0)
 i name'["," d  ; if no comma, then try a space
"RTN","SAMIDCM1",661,0)
 . i $l(name," ")>0 d  ;
"RTN","SAMIDCM1",662,0)
 . . n fnam,lnam
"RTN","SAMIDCM1",663,0)
 . . s fnam=$p(name," ",1)
"RTN","SAMIDCM1",664,0)
 . . s lnam=$p(name," ",$l(name," "))
"RTN","SAMIDCM1",665,0)
 . . s fnam=$p(name,lnam,1)
"RTN","SAMIDCM1",666,0)
 . . s znam=lnam_","_fnam
"RTN","SAMIDCM1",667,0)
 . . q
"RTN","SAMIDCM1",668,0)
 . q
"RTN","SAMIDCM1",669,0)
 ;
"RTN","SAMIDCM1",670,0)
 quit znam ; end of $$NORMALIZ^SAMIDCM1
