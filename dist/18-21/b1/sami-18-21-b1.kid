FNAME(SITE,FORM) ; extrinsic returns the filename for the site/form
"RTN","SAMICSV",388,0)
 ;
"RTN","SAMICSV",389,0)
 quit SITE_"-"_FORM_"-"_$$FMTHL7^XLFDT($$HTFM^XLFDT($H))_".csv" ; end of $$FNAME
