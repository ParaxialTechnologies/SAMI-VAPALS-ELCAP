 ; MKSVC create web services
"RTN","SAMIDCM1",154,0)
 ;
"RTN","SAMIDCM1",155,0)
 ;
"RTN","SAMIDCM1",156,0)
 ;
"RTN","SAMIDCM1",157,0)
 ;
