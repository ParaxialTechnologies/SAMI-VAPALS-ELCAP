 n images s images=""
"RTN","SAMIDCM2",143,0)
 n ien s ien=""
"RTN","SAMIDCM2",144,0)
 ;f  s ien=$o(@root@("studyid",SID,ien)) q:ien=""  d  ;
"RTN","SAMIDCM2",145,0)
 f  s ien=$o(@root@("emrn","e"_simrn,ien)) q:ien=""  d  ;
"RTN","SAMIDCM2",146,0)
 . n studydt s studydt=$g(@root@(ien,"json","StudyDate"))
"RTN","SAMIDCM2",147,0)
 . q:studydt=""
"RTN","SAMIDCM2",148,0)
 . ;
"RTN","SAMIDCM2",149,0)
 . n siuid s siuid=$g(@root@(ien,"json","StudyInstanceUID"))
"RTN","SAMIDCM2",150,0)
 . q:siuid=""
"RTN","SAMIDCM2",151,0)
 . n siurl s siurl=$g(@root@(ien,"json","url"))
"RTN","SAMIDCM2",152,0)
 . i siurl'="" s siuid=siurl
"RTN","SAMIDCM2",153,0)
 . ; add each image item only once to Items array
"RTN","SAMIDCM2",154,0)
 . q:$d(images(siuid))
"RTN","SAMIDCM2",155,0)
 . s images(siuid)=""
"RTN","SAMIDCM2",156,0)
 . ;
"RTN","SAMIDCM2",157,0)
 . n key s key="image-"_$e(studydt,1,4)_"-"_$e(studydt,5,6)_"-"_$e(studydt,7,8)
"RTN","SAMIDCM2",158,0)
 . n fmdt s fmdt=$$KEY2FM^SAMICASE(key)
"RTN","SAMIDCM2",159,0)
 . s @ARY@("sort",fmdt,"image",key,"Image")=siuid
"RTN","SAMIDCM2",160,0)
 . q
"RTN","SAMIDCM2",161,0)
 ;
"RTN","SAMIDCM2",162,0)
 quit  ; end of ADDITEMS
