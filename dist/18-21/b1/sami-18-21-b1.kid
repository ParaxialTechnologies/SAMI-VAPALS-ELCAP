"RTN","SAMICSV",142,0)
 ;
"RTN","SAMICSV",143,0)
EN ; entry point to generate csv files from forms for a site
"RTN","SAMICSV",144,0)
 ;
"RTN","SAMICSV",145,0)
 ;@stanza 2 select site
"RTN","SAMICSV",146,0)
 ;
"RTN","SAMICSV",147,0)
 ; first pick a site
"RTN","SAMICSV",148,0)
 N X,Y,DIC,SITEIEN,SITEID
"RTN","SAMICSV",149,0)
 S DIC=311.12
"RTN","SAMICSV",150,0)
 S DIC(0)="AEMQ"
"RTN","SAMICSV",151,0)
 D ^DIC
"RTN","SAMICSV",152,0)
 I Y<1 Q  ; EXIT
"RTN","SAMICSV",153,0)
 S SITENUM=$P(Y,"^",2)
"RTN","SAMICSV",154,0)
 ;
"RTN","SAMICSV",155,0)
 S SITEID=$$SITEID^SAMISITE(SITENUM)
"RTN","SAMICSV",156,0)
 Q:SITEID=""
"RTN","SAMICSV",157,0)
 ;
"RTN","SAMICSV",158,0)
 ;
"RTN","SAMICSV",159,0)
 ;@stanza 3 select form
"RTN","SAMICSV",160,0)
 ;
"RTN","SAMICSV",161,0)
 N SAMIFORM S SAMIFORM=$$SAYFORM()
"RTN","SAMICSV",162,0)
 Q:SAMIFORM=-1
"RTN","SAMICSV",163,0)
 ;
"RTN","SAMICSV",164,0)
 ;
"RTN","SAMICSV",165,0)
 ;@stanza 4 select directory
"RTN","SAMICSV",166,0)
 ;
"RTN","SAMICSV",167,0)
 ; prompt for the directory
"RTN","SAMICSV",168,0)
 N SAMIDIR
"RTN","SAMICSV",169,0)
 D GETDIR^SAMIFDM(.SAMIDIR)
"RTN","SAMICSV",170,0)
 Q:SAMIDIR=""
"RTN","SAMICSV",171,0)
 ;
"RTN","SAMICSV",172,0)
 d ONEFORM(SITEID,SAMIFORM,SAMIDIR) ; process one form for a site
"RTN","SAMICSV",173,0)
 ;
"RTN","SAMICSV",174,0)
 ;
"RTN","SAMICSV",175,0)
 ;@stanza 5 termination
"RTN","SAMICSV",176,0)
 ;
"RTN","SAMICSV",177,0)
 quit  ; end of EN
"RTN","SAMICSV",178,0)
 ;
"RTN","SAMICSV",179,0)
 ;
"RTN","SAMICSV",180,0)
 ;
"RTN","SAMICSV",181,0)
 ;
"RTN","SAMICSV",182,0)
 ;@func-code $$SAYFORM^SAMICSV
"RTN","SAMICSV",183,0)
 ;
"RTN","SAMICSV",184,0)
 ;@stanza 1 invocation, binding, & branching
"RTN","SAMICSV",185,0)
 ;
"RTN","SAMICSV",186,0)
 ;ven/gpl;private;pseudo-function;clean?;prompt;sac;??% tests;port?
"RTN","SAMICSV",187,0)
 ;@called-by
"RTN","SAMICSV",188,0)
 ; ^SAMICSV
"RTN","SAMICSV",189,0)
 ;@calls
"RTN","SAMICSV",190,0)
 ; ^DIR
"RTN","SAMICSV",191,0)
 ;@input [tbd]
"RTN","SAMICSV",192,0)
 ;@output = form
"RTN","SAMICSV",193,0)
 ;@tests [tbd]
"RTN","SAMICSV",194,0)
 ;
"RTN","SAMICSV",195,0)
 ;
"RTN","SAMICSV",196,0)
SAYFORM() ; prompts for the form
"RTN","SAMICSV",197,0)
 ;
"RTN","SAMICSV",198,0)
 ;@stanza 2 define set of codes
"RTN","SAMICSV",199,0)
 ;
"RTN","SAMICSV",200,0)
 N ZF
"RTN","SAMICSV",201,0)
 S ZF(1)="siform"
"RTN","SAMICSV",202,0)
 S ZF(2)="sbform"
"RTN","SAMICSV",203,0)
 S ZF(3)="ceform"
"RTN","SAMICSV",204,0)
 S ZF(4)="fuform"
"RTN","SAMICSV",205,0)
 S ZF(5)="bxform"
"RTN","SAMICSV",206,0)
 S ZF(6)="itform"
"RTN","SAMICSV",207,0)
 S ZF(7)="ptform"
"RTN","SAMICSV",208,0)
 S ZF(8)="cxform"
"RTN","SAMICSV",209,0)
 N DIR S DIR(0)="SO^"
"RTN","SAMICSV",210,0)
 N ZI
"RTN","SAMICSV",211,0)
 F ZI=1:1:7 S DIR(0)=DIR(0)_ZI_":"_ZF(ZI)_";"
"RTN","SAMICSV",212,0)
 ;
"RTN","SAMICSV",213,0)
 ;
"RTN","SAMICSV",214,0)
 ;@stanza 3 set up prompt
"RTN","SAMICSV",215,0)
 ;
"RTN","SAMICSV",216,0)
 S DIR("L")="Select form to extract:"
"RTN","SAMICSV",217,0)
 S DIR("L",1)="1 Intake form (siform)"
"RTN","SAMICSV",218,0)
 S DIR("L",2)="2 Background form (sbform)"
"RTN","SAMICSV",219,0)
 S DIR("L",3)="3 CT Evaluation form (ceform)"
"RTN","SAMICSV",220,0)
 S DIR("L",4)="4 Followup form (fuform)"
"RTN","SAMICSV",221,0)
 S DIR("L",5)="5 Biopsy form (bxform)"
"RTN","SAMICSV",222,0)
 S DIR("L",6)="6 Intervention form (itform)"
"RTN","SAMICSV",223,0)
 S DIR("L",7)="7 Pet Evaluation form (ptform)"
"RTN","SAMICSV",224,0)
 S DIR("L",8)="8 Chest X-Ray form (cxform)"
"RTN","SAMICSV",225,0)
 ;
"RTN","SAMICSV",226,0)
 ;
"RTN","SAMICSV",227,0)
 ;@stanza 4 prompt user to select a form
"RTN","SAMICSV",228,0)
 ;
"RTN","SAMICSV",229,0)
 D ^DIR
"RTN","SAMICSV",230,0)
 Q:X="" -1
"RTN","SAMICSV",231,0)
 ;
"RTN","SAMICSV",232,0)
 ;
"RTN","SAMICSV",233,0)
 ;@stanza 5 termination
"RTN","SAMICSV",234,0)
 ;
"RTN","SAMICSV",235,0)
 quit ZF(X) ; end of $$SAYFORM
"RTN","SAMICSV",236,0)
 ;
"RTN","SAMICSV",237,0)
 ;
"RTN","SAMICSV",238,0)
 ;
"RTN","SAMICSV",239,0)
 ;
"RTN","SAMICSV",240,0)
 ;@proc-code ONEFORM^SAMICSV
"RTN","SAMICSV",241,0)
 ;
"RTN","SAMICSV",242,0)
 ;@stanza 1 invocation, binding, & branching
"RTN","SAMICSV",243,0)
 ;
"RTN","SAMICSV",244,0)
 ;ven/gpl;private;procedure;clean;silent;sac;??% tests;port?
"RTN","SAMICSV",245,0)
 ;@called-by none
"RTN","SAMICSV",246,0)
 ;@calls
"RTN","SAMICSV",247,0)
 ; $$setroot^%wd
"RTN","SAMICSV",248,0)
 ; DDICT
"RTN","SAMICSV",249,0)
 ; $$FNAME
"RTN","SAMICSV",250,0)
 ; GTF^%ZISH
"RTN","SAMICSV",251,0)
 ;@input
"RTN","SAMICSV",252,0)
 ; SITEID =
"RTN","SAMICSV",253,0)
 ; SAMIFORM =
"RTN","SAMICSV",254,0)
 ; SAMIDIR =
"RTN","SAMICSV",255,0)
 ;@output [tbd]
"RTN","SAMICSV",256,0)
 ;@tests [tbd]
"RTN","SAMICSV",257,0)
 ;
"RTN","SAMICSV",258,0)
 ;
"RTN","SAMICSV",259,0)
ONEFORM(SITEID,SAMIFORM,SAMIDIR) ; process one form for a site
"RTN","SAMICSV",260,0)
 ;
"RTN","SAMICSV",261,0)
 n root s root=$$setroot^%wd("vapals-patients")
"RTN","SAMICSV",262,0)
 n groot s groot=$na(@root@("graph"))
"RTN","SAMICSV",263,0)
 n SAMII S SAMII=SITEID
"RTN","SAMICSV",264,0)
 n cnt s cnt=0
"RTN","SAMICSV",265,0)
 n forms s forms=0
"RTN","SAMICSV",266,0)
 ;
"RTN","SAMICSV",267,0)
 n SAMIOUT S SAMIOUT=$NA(^TMP("SAMICSV",$J))
"RTN","SAMICSV",268,0)
 k @SAMIOUT
"RTN","SAMICSV",269,0)
 ;
"RTN","SAMICSV",270,0)
 n DICT
"RTN","SAMICSV",271,0)
 d DDICT("DICT",SAMIFORM) ; get the data dictionary for this form
"RTN","SAMICSV",272,0)
 q:'$d(DICT)
"RTN","SAMICSV",273,0)
 ;
"RTN","SAMICSV",274,0)
 N SAMIN S SAMIN=1
"RTN","SAMICSV",275,0)
 N SAMIJJ s SAMIJJ=0
"RTN","SAMICSV",276,0)
 N OFFSET S OFFSET=1
"RTN","SAMICSV",277,0)
 d  ; start with last5 and name for all forms
"RTN","SAMICSV",278,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="last5"
"RTN","SAMICSV",279,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",280,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="saminame"
"RTN","SAMICSV",281,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",282,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="simrn"
"RTN","SAMICSV",283,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",284,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sipid"
"RTN","SAMICSV",285,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",286,0)
 ;
"RTN","SAMICSV",287,0)
 I SAMIFORM="siform" d  ;
"RTN","SAMICSV",288,0)
 . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",289,0)
 . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="saminame"
"RTN","SAMICSV",290,0)
 . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",291,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="ssn"
"RTN","SAMICSV",292,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",293,0)
 . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="last5"
"RTN","SAMICSV",294,0)
 . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",295,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sex"
"RTN","SAMICSV",296,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",297,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sbdob"
"RTN","SAMICSV",298,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV",299,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="samiru"
"RTN","SAMICSV",300,0)
 f  s SAMIJJ=$o(DICT(SAMIJJ)) q:+SAMIJJ=0  d  ;
"RTN","SAMICSV",301,0)
 . s $p(@SAMIOUT@(SAMIN),"|",SAMIJJ+OFFSET)=DICT(SAMIJJ) ; csv header
"RTN","SAMICSV",302,0)
 s @SAMIOUT@(SAMIN)="siteid|samistudyid|form|"_@SAMIOUT@(SAMIN)
"RTN","SAMICSV",303,0)
 ;S @SAMIOUT@(SAMIN)=@SAMIOUT@(SAMIN)_$C(13,10) ; carriage return line feed
"RTN","SAMICSV",304,0)
 ; 
"RTN","SAMICSV",305,0)
 f  s SAMII=$o(@groot@(SAMII)) q:SAMII=""  q:$e(SAMII,1,3)'[SITEID  d  ;
"RTN","SAMICSV",306,0)
 . s cnt=cnt+1
"RTN","SAMICSV",307,0)
 . w !,SAMII
"RTN","SAMICSV",308,0)
 . N SAMIJ S SAMIJ=SAMIFORM
"RTN","SAMICSV",309,0)
 . n done s done=0
"RTN","SAMICSV",310,0)
 . f  s SAMIJ=$O(@groot@(SAMII,SAMIJ)) q:SAMIJ=""  q:done  d  ;
"RTN","SAMICSV",311,0)
 . . i $e(SAMIJ,1,$l(SAMIFORM))'=SAMIFORM s done=1 q  ;
"RTN","SAMICSV",312,0)
 . . s forms=forms+1
"RTN","SAMICSV",313,0)
 . . n jj s jj=0
"RTN","SAMICSV",314,0)
 . . s SAMIN=SAMIN+1
"RTN","SAMICSV",315,0)
 . . S OFFSET=1
"RTN","SAMICSV",316,0)
 . . n kk s kk=$o(@root@("sid",SAMII,""))
"RTN","SAMICSV",317,0)
 . . q:kk=""
"RTN","SAMICSV",318,0)
 . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",319,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"last5"))
"RTN","SAMICSV",320,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",321,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"saminame"))
"RTN","SAMICSV",322,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",323,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"simrn"))
"RTN","SAMICSV",324,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",325,0)
 . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"sipid"))
"RTN","SAMICSV",326,0)
 . . S OFFSET=OFFSET+1
"RTN","SAMICSV",327,0)
 . . ;
"RTN","SAMICSV",328,0)
 . . I SAMIFORM="siform" d  ;
"RTN","SAMICSV",329,0)
 . . . ;n kk s kk=$o(@root@("sid",SAMII,""))
"RTN","SAMICSV",330,0)
 . . . ;q:kk=""
"RTN","SAMICSV",331,0)
 . . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",332,0)
 . . . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"saminame"))
"RTN","SAMICSV",333,0)
 . . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",334,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"ssn"))
"RTN","SAMICSV",335,0)
 . . . S OFFSET=OFFSET+1
"RTN","SAMICSV",336,0)
 . . . ;s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"last5"))
"RTN","SAMICSV",337,0)
 . . . ;S OFFSET=OFFSET+1
"RTN","SAMICSV",338,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"sex"))
"RTN","SAMICSV",339,0)
 . . . S OFFSET=OFFSET+1
"RTN","SAMICSV",340,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"sbdob"))
"RTN","SAMICSV",341,0)
 . . . S OFFSET=OFFSET+1
"RTN","SAMICSV",342,0)
 . . . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)=$g(@root@(kk,"samiru"))
"RTN","SAMICSV",343,0)
 . . f  s jj=$o(DICT(jj)) q:+jj=0  d  ;
"RTN","SAMICSV",344,0)
 . . . ;s $P(@SAMIOUT@(SAMIN),"|",OFFSET+jj)=""""_$g(@groot@(SAMII,SAMIJ,DICT(jj)))_""""
"RTN","SAMICSV",345,0)
 . . . n val
"RTN","SAMICSV",346,0)
 . . . ;s val=$g(@groot@(SAMII,SAMIJ,DICT(jj)))_""""
"RTN","SAMICSV",347,0)
 . . . s val=$g(@groot@(SAMII,SAMIJ,DICT(jj)))
"RTN","SAMICSV",348,0)
 . . . i val'="" d  ;
"RTN","SAMICSV",349,0)
 . . . . s val=$tr(val,$char(11))
"RTN","SAMICSV",350,0)
 . . . . s val=$tr(val,$char(13))
"RTN","SAMICSV",351,0)
 . . . . d findReplaceAll^%ts(.val,"""","""""")
"RTN","SAMICSV",352,0)
 . . . . s val=""""_val_""""
"RTN","SAMICSV",353,0)
 . . . s $P(@SAMIOUT@(SAMIN),"|",OFFSET+jj)=val
"RTN","SAMICSV",354,0)
 . . S @SAMIOUT@(SAMIN)=SITEID_"|"_SAMII_"|"_SAMIJ_"|"_@SAMIOUT@(SAMIN)
"RTN","SAMICSV",355,0)
 . . ;s @SAMIOUT@(SAMIN)=@SAMIOUT@(SAMIN)_$C(13,10)
"RTN","SAMICSV",356,0)
 . ;b
"RTN","SAMICSV",357,0)
 ;ZWR @SAMIOUT@(*)
"RTN","SAMICSV",358,0)
 w !,cnt_" patients, "_forms_" forms"
"RTN","SAMICSV",359,0)
 n filename s filename=$$FNAME(SITEID,SAMIFORM)
"RTN","SAMICSV",360,0)
 d GTF^%ZISH($na(@SAMIOUT@(1)),3,SAMIDIR,filename)
"RTN","SAMICSV",361,0)
 w !,"file "_filename_" written to directory "_SAMIDIR
"RTN","SAMICSV",362,0)
 ;
"RTN","SAMICSV",363,0)
 k @SAMIOUT
"RTN","SAMICSV",364,0)
 ;
"RTN","SAMICSV",365,0)
 quit  ; end of ONEFORM
"RTN","SAMICSV",366,0)
 ;
