 new active set active="inactive"
"RTN","SAMIUR2",583,0)
 if $d(@vals@("sies")),$get(@vals@("sies"))="ac" set active="active" ;
"RTN","SAMIUR2",584,0)
 e  if $d(@vals@("sistatus")),$get(@vals@("sistatus"))="active" set active="active"
