"RTN","SAMIDCM2",134,0)
 new proot set proot=$$setroot^%wd("vapals-patients")
"RTN","SAMIDCM2",135,0)
 new pien,simrn
"RTN","SAMIDCM2",136,0)
 set pien=$o(@proot@("sid",SID,""))
"RTN","SAMIDCM2",137,0)
 set simrn=$g(@proot@(pien,"simrn"))
"RTN","SAMIDCM2",138,0)
 q:simrn=""
"RTN","SAMIDCM2",139,0)
 ;
"RTN","SAMIDCM2",140,0)
 ;q:'$d(@root@("studyid",SID)) ; nothing to add
"RTN","SAMIDCM2",141,0)
 ;
