WSNEWCAS ; web route newcase (creates new case)
"RTN","SAMIHOM4",1667,0)
 ;
"RTN","SAMIHOM4",1668,0)
 ;@stanza 2 create new case
"RTN","SAMIHOM4",1669,0)
 ;
"RTN","SAMIHOM4",1670,0)
 merge ^SAMIUL("newCase","ARGS")=SAMIARGS
"RTN","SAMIHOM4",1671,0)
 merge ^SAMIUL("newCase","BODY")=SAMIBODY
"RTN","SAMIHOM4",1672,0)
 ;
"RTN","SAMIHOM4",1673,0)
 new vars,bdy
"RTN","SAMIHOM4",1674,0)
 set SAMIBDY=$get(SAMIBODY(1))
"RTN","SAMIHOM4",1675,0)
 if SAMIBDY="" M vars=SAMIARGS
"RTN","SAMIHOM4",1676,0)
 else  do parseBody^%wf("vars",.SAMIBDY)
"RTN","SAMIHOM4",1677,0)
 merge ^SAMIUL("newCase","vars")=vars
"RTN","SAMIHOM4",1678,0)
 ;
"RTN","SAMIHOM4",1679,0)
 new root set root=$$setroot^%wd("vapals-patients")
"RTN","SAMIHOM4",1680,0)
 new lroot set lroot=$$setroot^%wd("patient-lookup")
"RTN","SAMIHOM4",1681,0)
 ;
"RTN","SAMIHOM4",1682,0)
 new saminame set saminame=$get(vars("name"))
"RTN","SAMIHOM4",1683,0)
 if saminame="" s saminame=$get(vars("saminame"))
"RTN","SAMIHOM4",1684,0)
 ;if $$VALDTNM(saminame,.ARGS)=-1 do  quit  ;
"RTN","SAMIHOM4",1685,0)
 ;. new r1
"RTN","SAMIHOM4",1686,0)
 ;. do GETHOME(.r1,.ARGS) ; home page to redisplay
"RTN","SAMIHOM4",1687,0)
 ;. merge RESULT=r1
"RTN","SAMIHOM4",1688,0)
 ;. quit
"RTN","SAMIHOM4",1689,0)
 ;
"RTN","SAMIHOM4",1690,0)
 new dfn s dfn=$get(vars("dfn"))
"RTN","SAMIHOM4",1691,0)
 ;if dfn="" do  quit  ;
"RTN","SAMIHOM4",1692,0)
 ;. new r1
"RTN","SAMIHOM4",1693,0)
 ;. do GETHOME(.r1,.ARGS) ; home page to redisplay
"RTN","SAMIHOM4",1694,0)
 ;. merge RESULT=r1
"RTN","SAMIHOM4",1695,0)
 ;. quit
"RTN","SAMIHOM4",1696,0)
 ;
"RTN","SAMIHOM4",1697,0)
 ; new gien set gien=$$NEXTNUM
"RTN","SAMIHOM4",1698,0)
 new gien set gien=dfn
"RTN","SAMIHOM4",1699,0)
 ;
"RTN","SAMIHOM4",1700,0)
 merge ^SAMIUL("newCase","G1")=root
"RTN","SAMIHOM4",1701,0)
 ; create dfn index
"RTN","SAMIHOM4",1702,0)
 set @root@("dfn",dfn,gien)=""
"RTN","SAMIHOM4",1703,0)
 ;
"RTN","SAMIHOM4",1704,0)
 set @root@(gien,"saminum")=gien
"RTN","SAMIHOM4",1705,0)
 set @root@(gien,"saminame")=saminame
"RTN","SAMIHOM4",1706,0)
 ;
"RTN","SAMIHOM4",1707,0)
 new studyid set studyid=$$GENSTDID^SAMIHOM3(gien,.SAMIARGS)
"RTN","SAMIHOM4",1708,0)
 set @root@(gien,"samistudyid")=studyid
"RTN","SAMIHOM4",1709,0)
 set @root@("sid",studyid,gien)=""
"RTN","SAMIHOM4",1710,0)
 new lien set lien=$o(@lroot@("dfn",dfn,""))
"RTN","SAMIHOM4",1711,0)
 set @lroot@("studyid",studyid,lien)=""
"RTN","SAMIHOM4",1712,0)
 ;
"RTN","SAMIHOM4",1713,0)
 new datekey set datekey=$$KEYDATE^SAMIHOM3($$NOW^XLFDT)
"RTN","SAMIHOM4",1714,0)
 set @root@(gien,"samicreatedate")=datekey
"RTN","SAMIHOM4",1715,0)
 ;
"RTN","SAMIHOM4",1716,0)
 merge ^SAMIUL("newCase",gien)=@root@(gien)
"RTN","SAMIHOM4",1717,0)
 ;
"RTN","SAMIHOM4",1718,0)
 ;
"RTN","SAMIHOM4",1719,0)
 do PREFILL^SAMIHOM3(dfn) ; prefills from the "patient-lookup" graph
"RTN","SAMIHOM4",1720,0)
 ;
"RTN","SAMIHOM4",1721,0)
 new siformkey
"RTN","SAMIHOM4",1722,0)
 ; do makeSbform(gien) ; create background form for new patient
"RTN","SAMIHOM4",1723,0)
 set siformkey=$$MKSIFORM^SAMIHOM3(gien) ; create intake for new patient
"RTN","SAMIHOM4",1724,0)
 ;
"RTN","SAMIHOM4",1725,0)
 set SAMIARGS("studyid")=studyid
"RTN","SAMIHOM4",1726,0)
 set SAMIARGS("form")="vapals:"_siformkey
"RTN","SAMIHOM4",1727,0)
 do wsGetForm^%wf(.SAMIRESULT,.SAMIARGS)
"RTN","SAMIHOM4",1728,0)
 ; do WSCASE^SAMICASE(.SAMIRESULT,.SAMIARGS) ; navigate to case review page
"RTN","SAMIHOM4",1729,0)
 ;
"RTN","SAMIHOM4",1730,0)
 ;
"RTN","SAMIHOM4",1731,0)
 ;@stanza 3 termination
"RTN","SAMIHOM4",1732,0)
 ;
"RTN","SAMIHOM4",1733,0)
 quit  ; end of wrs WSNEWCAS^SAMIHOM3
"RTN","SAMIHOM4",1734,0)
 ;
