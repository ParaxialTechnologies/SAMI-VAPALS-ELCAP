ONEFORM(SITEID,SAMIFORM,SAMIDIR) ; process one form for a site
"RTN","SAMICSV2",259,0)
 ;
"RTN","SAMICSV2",260,0)
 n root s root=$$setroot^%wd("vapals-patients")
"RTN","SAMICSV2",261,0)
 n groot s groot=$na(@root@("graph"))
"RTN","SAMICSV2",262,0)
 n SAMII S SAMII=SITEID
"RTN","SAMICSV2",263,0)
 n cnt s cnt=0
"RTN","SAMICSV2",264,0)
 n forms s forms=0
"RTN","SAMICSV2",265,0)
 ;
"RTN","SAMICSV2",266,0)
 n SAMIOUT S SAMIOUT=$NA(^TMP("SAMICSV",$J))
"RTN","SAMICSV2",267,0)
 k @SAMIOUT
"RTN","SAMICSV2",268,0)
 ;
"RTN","SAMICSV2",269,0)
 n DICT
"RTN","SAMICSV2",270,0)
 d DDICT("DICT",SAMIFORM) ; get the data dictionary for this form
"RTN","SAMICSV2",271,0)
 q:'$d(DICT)
"RTN","SAMICSV2",272,0)
 ;
"RTN","SAMICSV2",273,0)
 N SAMIN S SAMIN=1
"RTN","SAMICSV2",274,0)
 N SAMIJJ s SAMIJJ=0
"RTN","SAMICSV2",275,0)
 N OFFSET S OFFSET=1
"RTN","SAMICSV2",276,0)
 d  ; start with last5 and name for all forms
"RTN","SAMICSV2",277,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="last5"
"RTN","SAMICSV2",278,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV2",279,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="saminame"
"RTN","SAMICSV2",280,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV2",281,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="simrn"
"RTN","SAMICSV2",282,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV2",283,0)
 . s $p(@SAMIOUT@(SAMIN),"|",OFFSET)="sipid"
"RTN","SAMICSV2",284,0)
 . S OFFSET=OFFSET+1
"RTN","SAMICSV2",285,0)
