 S ZF(1)="siform"
"RTN","SAMICSV2",203,0)
 S ZF(2)="sbform"
"RTN","SAMICSV2",204,0)
 S ZF(3)="ceform"
"RTN","SAMICSV2",205,0)
 S ZF(4)="fuform"
"RTN","SAMICSV2",206,0)
 S ZF(5)="bxform"
"RTN","SAMICSV2",207,0)
 S ZF(6)="itform"
"RTN","SAMICSV2",208,0)
 S ZF(7)="ptform"
"RTN","SAMICSV2",209,0)
 N DIR S DIR(0)="SO^"
"RTN","SAMICSV2",210,0)
 N ZI
"RTN","SAMICSV2",211,0)
 F ZI=1:1:7 S DIR(0)=DIR(0)_ZI_":"_ZF(ZI)_";"
