"RTN","SAMIDCM1",159,0)
 ;
"RTN","SAMIDCM1",160,0)
 ;@stanza 1 invocation, binding, & branching
"RTN","SAMIDCM1",161,0)
 ;
"RTN","SAMIDCM1",162,0)
 ;ven/gpl;ws;procedure;clean?;silent;sac?;??% tests;port?
"RTN","SAMIDCM1",163,0)
 ;@called-by
"RTN","SAMIDCM1",164,0)
 ; web service post dcmin
"RTN","SAMIDCM1",165,0)
 ; web service post dcmimgin
"RTN","SAMIDCM1",166,0)
