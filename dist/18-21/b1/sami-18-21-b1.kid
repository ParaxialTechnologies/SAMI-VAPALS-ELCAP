"RTN","SAMICSV",403,0)
 ;@input
"RTN","SAMICSV",404,0)
 ; RTN = output array name, closed reference
"RTN","SAMICSV",405,0)
 ; FORM = form whose DD should be returned in @RTN
"RTN","SAMICSV",406,0)
 ;@output
"RTN","SAMICSV",407,0)
 ; @RTN: DD for FORM
"RTN","SAMICSV",408,0)
 ;@tests [tbd]
"RTN","SAMICSV",409,0)
 ;
"RTN","SAMICSV",410,0)
