"RTN","SAMICSV",411,0)
DDICT(RTN,FORM) ; data dictionary for FORM
"RTN","SAMICSV",412,0)
 ;
"RTN","SAMICSV",413,0)
 ;@stanza 2 identify form
"RTN","SAMICSV",414,0)
 ;
"RTN","SAMICSV",415,0)
 K @RTN
"RTN","SAMICSV",416,0)
 ;
"RTN","SAMICSV",417,0)
 N USEGR S USEGR=""
"RTN","SAMICSV",418,0)
 I FORM="siform" S USEGR="form fields - intake"
"RTN","SAMICSV",419,0)
 I FORM="sbform" S USEGR="form fields - background"
"RTN","SAMICSV",420,0)
 I FORM="ceform" S USEGR="form fields - ct evaluation"
"RTN","SAMICSV",421,0)
 I FORM="fuform" S USEGR="form fields - follow up"
"RTN","SAMICSV",422,0)
 I FORM="bxform" S USEGR="form fields - biopsy"
"RTN","SAMICSV",423,0)
 I FORM="itform" S USEGR="form fields - intervention"
"RTN","SAMICSV",424,0)
 I FORM="ptform" S USEGR="form fields - pet evaluation"
"RTN","SAMICSV",425,0)
 Q:USEGR=""
"RTN","SAMICSV",426,0)
 ;
"RTN","SAMICSV",427,0)
 ;
"RTN","SAMICSV",428,0)
 ;@stanza 3 get DD
"RTN","SAMICSV",429,0)
 ;
"RTN","SAMICSV",430,0)
 N root s root=$$setroot^%wd(USEGR)
"RTN","SAMICSV",431,0)
 Q:$g(root)=""
"RTN","SAMICSV",432,0)
 ;
"RTN","SAMICSV",433,0)
 N II S II=0
"RTN","SAMICSV",434,0)
 f  s II=$o(@root@("field",II)) q:+II=0  d  ;
"RTN","SAMICSV",435,0)
 . s @RTN@(II)=$g(@root@("field",II,"input",1,"name"))
"RTN","SAMICSV",436,0)
 . q
"RTN","SAMICSV",437,0)
 ;
"RTN","SAMICSV",438,0)
 ;
"RTN","SAMICSV",439,0)
 ;@stanza 4 termination
"RTN","SAMICSV",440,0)
 ;
